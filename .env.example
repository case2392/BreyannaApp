# Copy to .env and fill in. In production set these in your host's dashboard.

# Postgres connection string (from Neon, Vercel Postgres, Supabase, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret used to sign login sessions. Use a long random string in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Protects the one-time /api/setup endpoint used to load demo data after
# deploying. Pick any hard-to-guess value.
SETUP_KEY="pick-a-secret-setup-key"

# --- Messaging (optional) ---------------------------------------------------
# Leave these blank to run in "simulation mode" (messages are logged but not
# actually delivered). Fill them in to send real emails / texts.

# Email via Resend (https://resend.com). Create an API key and a verified
# sender. RESEND_FROM should be like: "Dwell Studio <hello@yourdomain.com>".
RESEND_API_KEY=""
RESEND_FROM="Dwell Studio <onboarding@resend.dev>"

# SMS via Twilio (https://twilio.com). From a registered Twilio phone number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Used by the daily class-reminder cron job (and accepted by /api/cron/*).
CRON_SECRET=""
